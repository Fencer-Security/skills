{
  "name": "fencer-skills-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Dev tooling for the Fencer skills marketplace. Skill TS scripts are bun-runnable directly — this package only declares dev dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "format": "oxfmt --no-error-on-unmatched-pattern 'plugins/**/*.{js,jsx,ts,tsx,mjs}' '**/*.{yaml,yml,toml,md}'",
    "format:check": "oxfmt --check --no-error-on-unmatched-pattern 'plugins/**/*.{js,jsx,ts,tsx,mjs}' '**/*.{yaml,yml,toml,md}'"
  },
  "devDependencies": {
    "oxfmt": ">=0.43.0",
    "oxlint": ">=1.55.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
