root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,yml,yaml}]
indent_style = space
charset = utf-8
indent_size = 4

[*.{yml,yaml}]
indent_size = 4

[*.md]
indent_style = space
end_of_line = lf
trim_trailing_whitespace = false

[*.{js,ts,tsx,jsx,mjs,html,css,scss}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4

[*.json]
indent_style = space
indent_size = 2
